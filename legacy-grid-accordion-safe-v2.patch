@@ -2257,6 +2257,38 @@ body.fm-responsive-legacy [class*=button-bar] {
     transition-duration: .01ms !important;
   }
 }
+
+
+/* --- Grilla principal full-height dentro de iframe legacy --- */
+/*
+ * El acordeón mantiene su display/height/overflow originales. Estas reglas sólo
+ * afectan a la grilla principal detectada dentro del segundo panel de resultados.
+ * useLegacyIframeLayout.js calcula el alto disponible y lo publica como variable.
+ */
+@media (min-width: 769px) {
+  body.fm-responsive-legacy .fm-legacy-main-grid {
+    width: 100% !important;
+    max-width: 100% !important;
+    min-width: 0 !important;
+    min-height: 0 !important;
+    max-height: none !important;
+  }
+
+  body.fm-responsive-legacy .fm-legacy-main-grid-scroll {
+    height: var(--fm-legacy-main-grid-body-height, auto) !important;
+    min-height: 160px !important;
+    max-height: var(--fm-legacy-main-grid-body-height, none) !important;
+    overflow-x: auto !important;
+    overflow-y: auto !important;
+    overscroll-behavior: contain !important;
+  }
+
+  body.fm-responsive-legacy .fm-legacy-main-grid-paginator {
+    width: 100% !important;
+    max-width: 100% !important;
+  }
+}
+
 /* ===== FIN: fm-legacy-responsive.css ===== */
 
