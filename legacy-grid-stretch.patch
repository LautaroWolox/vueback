+const findGridParts = (content, view) => {
+  if (!content || !view) return { gridShell: null, gridScroll: null }
+
+  let gridShell = content.querySelector(GRID_SHELL_SELECTORS)
+  let gridScroll = content.querySelector(GRID_SCROLL_SELECTORS)
+
+  // Fallback para grillas legacy que no exponen una de las clases conocidas.
+  if (!gridScroll) {
+    const candidates = [...content.querySelectorAll('div')].filter((element) => {
+      const style = view.getComputedStyle(element)
+      const overflowY = style.overflowY
+      return (overflowY === 'auto' || overflowY === 'scroll') && element.querySelector('table')
+    })
+
+    gridScroll = candidates.sort((a, b) => b.clientHeight - a.clientHeight)[0] || null
+  }
+
+  if (!gridShell && gridScroll) {
+    gridShell = gridScroll.closest(GRID_SHELL_SELECTORS) || gridScroll.parentElement
+  }
+
+  if (!gridShell) {
+    const table = content.querySelector('table')
+    gridShell = table?.closest('div') || table?.parentElement || null
+  }
+
+  return { gridShell, gridScroll }
+}
+
+const sizeLegacyGridToViewport = (doc, view, gridShell, gridScroll) => {
+  if (!doc?.body || !view || !gridShell) return
+
+  const viewportHeight = view.innerHeight || doc.documentElement.clientHeight || 0
+  if (!viewportHeight) return
+
+  const shellRect = gridShell.getBoundingClientRect()
+  if (!shellRect.height || shellRect.top >= viewportHeight) return
+
+  // La grilla debe terminar al ras del viewport del iframe.
+  const targetShellHeight = Math.max(Math.floor(viewportHeight - Math.max(shellRect.top, 0) - 4), 180)
+  gridShell.style.setProperty('--fm-legacy-grid-shell-height', `${targetShellHeight}px`)
+
+  if (!gridScroll) return
+
+  const scrollRect = gridScroll.getBoundingClientRect()
+  const nonScrollableHeight = Math.max(shellRect.height - scrollRect.height, 0)
+  const targetScrollHeight = Math.max(Math.floor(targetShellHeight - nonScrollableHeight), 120)
+
+  gridScroll.style.setProperty('--fm-legacy-grid-scroll-height', `${targetScrollHeight}px`)
+}
+
